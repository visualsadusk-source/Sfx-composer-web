# ==============================================================================
# SFX Composer — Environment Configuration Example (.env.example)
# Copy this file to .env and configure with your real credentials.
# NEVER commit your actual .env file or API secrets to public version control.
# ==============================================================================

PORT=3000

# ── 1. Razorpay Payment Gateway (Live or Test Mode) ──
# Get these from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Optional: Razorpay Webhook Secret (from Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ── 2. Product Delivery & Google Drive Link ──
PRICE_INR=199
SFX_LIBRARY_DRIVE_URL=https://drive.google.com/file/d/1rF1f3KEKSpri1KoZqP8SCv-Q0-NYxvGD/view?usp=sharing

# ── 3. Optional Supabase Backend (if using Supabase Edge Functions) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ── 4. Optional Brevo Email API (for automated customer receipts) ──
BREVO_API_KEY=your_brevo_v3_api_key_here
